---
interface Props { id:number; title:string; url:string; clicks:number }
const { id, title, url, clicks } = Astro.props;
---
<article
  class="rounded-xl p-4 bg-[#12131a]
         ring-1 ring-white/10 ring-offset-1 ring-offset-[#12131a]
         hover:ring-fuchsia-600/80 hover:ring-2
         transition duration-200">
  <div class="flex items-center justify-between gap-2">
    <h3 class="text-sm font-medium truncate">{title}</h3>
    <div class="flex gap-2">
      <a href="#" class="js-open-detail text-xs px-2 py-1 rounded-md bg-white/10 hover:bg-white/20"
         data-id={id}>詳細</a>
      <a href={url} target="_blank" rel="noopener"
         class="bg-fuchsia-600 hover:bg-fuchsia-500 text-white px-3 py-1 rounded-md text-xs">開く</a>
    </div>
  </div>
  <p class="text-[11px] text-gray-400 break-all mt-1">{url}</p>
  <p class="text-[11px] text-gray-500 mt-1">アクセス: {clicks}</p>
</article>
