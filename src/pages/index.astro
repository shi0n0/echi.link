---
import "../styles/tailwind.css";
import Header from "../components/Header.astro";
import SearchBox from "../components/SearchBox.astro";
import DetailModal from "../components/DetailModal.astro";
import LinkCard from "../components/LinkCard.astro";

let latest = [];
try {
  const res = await fetch(new URL("/api/latest", Astro.url));
  if (res.ok) latest = await res.json();
} catch {}
---
<html lang="ja">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Echi.link</title></head>
  <body class="bg-black text-gray-100 min-h-screen">
    <Header />
    <main class="max-w-6xl mx-auto px-4 py-8 space-y-6">
      <div class="flex items-center justify-between gap-3">
        <h2 class="text-lg font-semibold">最新のリンク</h2>
        <SearchBox />
      </div>

      <div id="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {latest.map((item: any) => <LinkCard {...item} />)}
      </div>
    </main>

    <DetailModal />

    <script is:inline>
      const grid = document.getElementById('grid');
      addEventListener("echi:search", (e) => {
        const { data, term } = e.detail;
        if (!grid) return;
        if (!data?.length) {
          grid.innerHTML = `<p class="text-gray-400 text-sm col-span-full">"${term}" に一致する結果はありません。</p>`;
          return;
        }
        grid.innerHTML = data.map(d => `
          <article
            class="rounded-xl p-4 bg-[#12131a]
                  ring-1 ring-white/10 ring-offset-1 ring-offset-[#12131a]
                  hover:ring-fuchsia-600/80 hover:ring-2
                  transition duration-200">
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-sm font-medium truncate">${d.title}</h3>
              <div class="flex gap-2">
                <a href="#" class="js-open-detail text-xs px-2 py-1 rounded-md bg-white/10 hover:bg-white/20" data-id="${d.id}">詳細</a>
                <a href="${d.url}" target="_blank" rel="noopener"
                  class="bg-fuchsia-600 hover:bg-fuchsia-500 text-white px-3 py-1 rounded-md text-xs">開く</a>
              </div>
            </div>
            <p class="text-[11px] text-gray-400 break-all mt-1">${d.url}</p>
            <p class="text-[11px] text-gray-500 mt-1">アクセス: ${d.clicks ?? 0}</p>
          </article>
        `).join("");
      });
    </script>
  </body>
</html>
