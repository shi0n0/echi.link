---
import Header from "../components/Header.astro";
import LinkCard from "../components/LinkCard.astro";
import "../styles/tailwind.css"; // ← ここが肝（<link>ではなくimport）

let latest = [];
try {
  const res = await fetch(new URL("/api/latest", Astro.url));
  if (res.ok) latest = await res.json();
} catch {}
---
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Echi.link</title>
  </head>
  <body class="bg-black text-gray-100 min-h-screen">
    <Header />
    <main class="max-w-6xl mx-auto px-4 py-8">
      <h2 class="text-lg font-semibold mb-4 border-b border-white/10 pb-2">最新のリンク</h2>
      {latest.length
        ? <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {latest.map((item: any) => <LinkCard {...item} />)}
          </div>
        : <p class="text-gray-400 text-sm">まだ投稿がありません。</p>}
    </main>
  </body>
</html>
